# Copy to .env and fill in. .env is git-ignored - never commit it.
# This agent is standalone: it does NOT need the amazon-sp-api-ingest .env (no Amazon keys here).

# Database (Azure SQL DAYHANSA_SQL1) - the shared daylight_agents login
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_PORT=1433

# Azure ML (AutoML). No secret: laptop uses `az login`, the VM uses its managed identity.
# Laptop: set this (az account show --query id -o tsv). On the VM leave blank; it is read from Azure.
AZUREML_SUBSCRIPTION_ID=
# AZUREML_RESOURCE_GROUP=rg-daylight-ml
# AZUREML_WORKSPACE=Daylight-az-ml-workspace
# AZUREML_COMPUTE=cpu-cluster
# AZUREML_MAX_NODES=2
