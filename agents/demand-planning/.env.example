# ─────────────────────────────────────────────────────────────────────────────
# Daylight Prophet Forecast — database credentials
#
# Copy this file to ".env" (same folder) and fill in the values below.
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
#
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

DB_SERVER=daylight-powerbi-db-1.database.windows.net
DB_NAME=DAYHANSA_SQL1
DB_USER=your_username_here
DB_PASSWORD=your_password_here

# DB_NAME, DB_USER and DB_PASSWORD are REQUIRED: the app has no built-in defaults
# for them and refuses to connect if any is empty.
#
# Use the ODBC driver version installed on the machine (msodbcsql17 or msodbcsql18).
# The default if unset is "ODBC Driver 18 for SQL Server".
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_PORT=1433

# Optional: write a run's CSV outputs somewhere other than ./output.
# run_forecast_cycle.sh sets this itself to output/runs/<timestamp>.
# FORECAST_OUTPUT_DIR=
