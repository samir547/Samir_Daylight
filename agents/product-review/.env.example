# Copy this file to .env and fill in real values. Never commit .env itself.

# Required for --provider groq (default)
GROQ_API_KEY=your_groq_api_key_here

# Required for --provider claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: sets the default --provider without passing the flag each time
LLM_PROVIDER=groq

# Required to pull review exports from SharePoint instead of local Reviews/
# files. SP_SHARE_URL is the sharing link to the folder containing the three
# exports; SP_USERNAME/SP_PASSWORD are a work/school account with read access
# to it. Sign-in uses Resource Owner Password Credentials (ROPC) via MSAL,
# which only works if the account has no MFA / blocking Conditional Access
# policy -- see the SharePoint section in README.md.
SP_SHARE_URL=https://yourtenant-my.sharepoint.com/:f:/p/user/xxxxxxxxxxxxxxxxxxxxxxxx
SP_USERNAME=your_email@yourtenant.com
SP_PASSWORD=your_password_here
# Optional overrides -- only needed if the default public client ID (Microsoft
# Graph PowerShell's first-party app) isn't consented for ROPC in your tenant.
# SP_CLIENT_ID=
# SP_TENANT_ID=organizations
# Optional: override the SharePoint subfolder paths the sync reads from (relative to
# whatever SP_SHARE_URL resolves to). Defaults shown below.
# SP_TRUSTPILOT_PRODUCT_DIR=TrustPilot/Product/In Progress
# SP_TRUSTPILOT_SERVICE_DIR=TrustPilot/Service/In Progress
# SP_AMAZON_PRODUCT_DIR=Amazon/In Progress
# Optional: override where each source's file is moved to once its reviews are
# confirmed loaded into the database. Defaults shown below.
# SP_TRUSTPILOT_PRODUCT_PROCESSED_DIR=TrustPilot/Product/Processed
# SP_TRUSTPILOT_SERVICE_PROCESSED_DIR=TrustPilot/Service/Processed
# SP_AMAZON_PRODUCT_PROCESSED_DIR=Amazon/Processed

# Required to load the two JSON outputs into SQL Server. Tables
# (dbo.sentiment_analysis_reviews, dbo.sentiment_analysis_runs) are created
# automatically on first load if they don't exist. Reviews are upserted keyed
# on uid, so reloading the same or an overlapping file never creates duplicates.
DB_SERVER=yourserver.database.windows.net
DB_NAME=yourdatabase
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_PORT=1433
