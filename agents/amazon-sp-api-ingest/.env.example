# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.
# One refresh token per marketplace. US, DE, FR, IT and ES share one Amazon app; the UK has its own.

# Shared app (US, DE, FR, IT, ES)
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN_US=
SPAPI_REFRESH_TOKEN_DE=
SPAPI_REFRESH_TOKEN_FR=
SPAPI_REFRESH_TOKEN_IT=
SPAPI_REFRESH_TOKEN_ES=

# UK app (its own client id/secret)
SPAPI_CLIENT_ID_UK=
SPAPI_CLIENT_SECRET_UK=
SPAPI_REFRESH_TOKEN_UK=

# Database (Azure SQL DAYHANSA_SQL1) for --sink db and load_csv_to_db.py.
# Same names as the demand-planning agent. DB_SERVER, DB_NAME, DB_USER and
# DB_PASSWORD are required; the VM uses its own least-privilege login (RUNBOOK).
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_PORT=1433

# Optional loader tuning (db.py): rows per batch into #stage, and fast_executemany (1/0).
# DB_BATCH_ROWS=500
# DB_FAST_EXECUTEMANY=1
