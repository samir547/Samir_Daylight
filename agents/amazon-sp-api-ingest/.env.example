# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.
# One refresh token per marketplace. US, DE, FR, IT and ES share one Amazon app; the UK has its own.

# Shared app (US, DE, FR, IT, ES)
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN_US=
SPAPI_REFRESH_TOKEN_DE=
SPAPI_REFRESH_TOKEN_FR=
SPAPI_REFRESH_TOKEN_IT=
SPAPI_REFRESH_TOKEN_ES=

# UK app (its own client id/secret)
SPAPI_CLIENT_ID_UK=
SPAPI_CLIENT_SECRET_UK=
SPAPI_REFRESH_TOKEN_UK=

# SQL Server target for ingest_to_db.py (loads data/*.csv into
# dbo.Daylight_sales_report and dbo.Daylight_inventory_report).
DB_SERVER=daylight-powerbi-db-1.database.windows.net
DB_NAME=DAYHANSA_SQL1
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_PORT=1433
